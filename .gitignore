# Root .gitignore for ISL workspace

# Python
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/.venv/
**/dist/
**/*.egg-info/
**/*.so

# Node / Frontend
**/node_modules/
**/.pnpm-store/
**/dist/
**/.vite/

# Environment files with sensitive credentials (if any)
**/.env.local
**/.env.*.local

# Testing and IDE
**/.pytest_cache/
**/*.log
**/.vscode/
**/.idea/
**/*.swp
Thumbs.db
.DS_Store

